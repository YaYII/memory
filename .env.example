# MCP 记忆系统环境配置文件示例
# 复制此文件为 .env 并填写您的实际配置

# ============================================
# LLM API 密钥配置（至少配置一个）
# ============================================

# DeepSeek API 密钥（推荐，优先级最高）
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # 可选，自定义API地址
# DEEPSEEK_PRIORITY=100  # 优先级，数值越高越优先

# 智谱 GLM API 密钥（备选）
# 获取地址: https://open.bigmodel.cn/
# GLM_API_KEY=your_glm_api_key_here
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  # 可选
# GLM_PRIORITY=50  # 优先级

# OpenAI API 密钥（可选）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # 可选
# OPENAI_PRIORITY=80

# Anthropic Claude API 密钥（可选）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_PRIORITY=90

# ============================================
# 多模型配置（高级，可选）
# 使用 JSON 数组格式配置多个模型提供商
# 优先级: 数值越高越优先使用
# ============================================
# LLM_PROVIDERS='[{"name":"deepseek","api_key":"your_key","priority":100},{"name":"glm","api_key":"your_key","priority":50}]'

# ============================================
# MCP 服务核心配置
# ============================================

# 服务端口（默认：22888）
MCP_MEMORY_PORT=22888

# 是否开启共享模式（多项目共享记忆）
# true: 所有项目共享同一套记忆
# false: 每个项目有独立的记忆空间（默认）
MCP_MEMORY_SHARED=false

# 项目ID（可选，自动检测当前目录）
# 默认使用当前工作目录的哈希值
# MCP_PROJECT_ID=my_project_1234

# 数据存储路径（可选，默认在用户目录下）
# CHROMA_DATA_PATH=/custom/path/to/chroma

# 记忆语言设置（默认：简体中文）
MCP_MEMORY_LANGUAGE=简体中文

# 首选LLM提供商（glm/deepseek/openai/anthropic）
MCP_LLM_PROVIDER=deepseek

# ============================================
# 自我进化调度配置
# ============================================

# 是否启用自动进化功能
MCP_EVOLUTION_ENABLED=true

# 扫描间隔（秒），默认5分钟
MCP_EVOLUTION_SCAN_INTERVAL_SECONDS=300

# 反思间隔（秒），默认30分钟
MCP_EVOLUTION_REFLECTION_INTERVAL_SECONDS=1800

# 每次扫描的记忆批次大小
MCP_EVOLUTION_SCAN_BATCH_SIZE=50

# 进化任务使用的用户ID
MCP_EVOLUTION_REFLECTION_USER_ID=system_evolution

# 进化配置文件（standard/minimal/aggressive）
MCP_EVOLUTION_PROFILE=standard

# 是否启用自适应调度
MCP_EVOLUTION_ADAPTIVE=true

# ============================================
# Token 池配置
# ============================================

# 每日Token限额
TOKEN_POOL_DAILY_LIMIT=100000

# 每月Token限额
TOKEN_POOL_MONTHLY_LIMIT=1000000

# ============================================
# 使用说明
# ============================================
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env 文件，填入您的 API 密钥
# 3. 至少配置一个 LLM API 密钥（推荐 DeepSeek）
# 4. 如需多模型备份，可配置多个 API 密钥
# 5. 修改配置后需要重启服务生效
#
# 启动服务命令:
#   python -m mcp_memory.server
#
# 或使用 MCP CLI:
#   mcp run src/mcp_memory/server.py
# ============================================
