#!/bin/bash
# Memory CLI 包装脚本
# 使用方法: ./memory <command> [options]

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 切换到项目目录
cd "$SCRIPT_DIR"

# 检查虚拟环境
if [ ! -d ".venv" ]; then
    echo "❌ 错误: 未找到虚拟环境！"
    echo "请先创建虚拟环境: python3 -m venv .venv"
    echo "然后安装依赖: .venv/bin/pip install -r requirements.txt"
    exit 1
fi

# 设置环境变量
export PYTHONPATH="$SCRIPT_DIR/src"

# 使用虚拟环境的Python执行CLI
exec .venv/bin/python -m mcp_memory.cli "$@"